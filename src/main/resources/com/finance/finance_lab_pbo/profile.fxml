                <Button fx:id="incomeBtn" mnemonicParsing="false" onAction="#handleNavigation" prefHeight="45.0" prefWidth="170.0" style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1.5; -fx-border-radius: 25; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px; -fx-cursor: hand;" text="Income">
