                    <!-- Bio TextArea for editing -->
                    <TextArea fx:id="bioTextArea" layoutX="30.0" layoutY="80.0" prefHeight="250.0" prefWidth="640.0" promptText="Write your bio here..." style="-fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-radius: 8;" wrapText="true">
