                    <HBox alignment="CENTER_RIGHT" layoutX="420.0" layoutY="350.0" spacing="15.0">
                        <children>
                            <!-- Delete Button -->
                            <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#deleteBio" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" text="Delete">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Button>

                            <!-- Update Button -->
                            <Button fx:id="updateBtn" mnemonicParsing="false" onAction="#updateBio" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #4a7c59; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" text="Update">
