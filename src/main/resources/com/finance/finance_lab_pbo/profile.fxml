<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="834.0" prefWidth="1539.0" style="-fx-background-color: linear-gradient(to bottom, #3a5998, #2a4a7c);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.finance.finance_lab_pbo.ProfileController">
    <children>

        <!-- Main Content Area -->
        <AnchorPane layoutX="201.0" layoutY="10.0" prefHeight="834.0" prefWidth="1339.0" style="-fx-background-color: linear-gradient(to bottom, #4a90a4, #357a93);">
            <children>

                <!-- Profile Card -->
                <AnchorPane layoutX="249.0" layoutY="152.0" prefHeight="530.0" prefWidth="773.0" style="-fx-background-color: rgba(255, 255, 255, 0.8); -fx-background-radius: 20;">
                    <children>
                        <!-- Profile Picture Circle -->
                        <Circle centerX="80.0" centerY="80.0" fill="#4a90a4" layoutX="60.0" layoutY="134.0" radius="83.0" stroke="WHITE" strokeWidth="3.0" />

                        <!-- User Name -->
                        <Label layoutX="270.0" layoutY="55.0" prefHeight="60.0" prefWidth="326.0" text="Justin Hubner" textFill="#2a3f5f">
                            <font>
                                <Font name="System Bold" size="39.0" />
                            </font>
                        </Label>

                        <!-- Email -->
                        <Label layoutX="265.0" layoutY="121.0" text="Email : justin@gmail.com" textFill="#555555">
                            <font>
                                <Font size="25.0" />
                            </font>
                        </Label>

                        <!-- Description -->
                        <Label layoutX="265.0" layoutY="171.0" text="Someone who wants to track finances" textFill="#555555">
                            <font>
                                <Font size="21.0" />
                            </font>
                        </Label>

                        <!-- Bio TextField - Clickable to open popup -->
                        <TextField fx:id="bioTextField" alignment="TOP_LEFT" layoutX="265.0" layoutY="214.0" onMouseClicked="#showBioPopup" prefHeight="114.0" prefWidth="364.0" promptText="Add Bio Here" style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-cursor: hand;" />

                        <!-- Change Password Button -->
                        <Button layoutX="124.0" layoutY="367.0" mnemonicParsing="false" prefHeight="46.0" prefWidth="546.0" style="-fx-background-color: #4a7c59; -fx-text-fill: white; -fx-background-radius: 20;" text="Change Password">
