                                <Insets bottom="8.0" top="8.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </children>
        </AnchorPane>

        <!-- Sidebar Navigation -->
        <VBox prefHeight="834.0" prefWidth="226.0" spacing="15.0" style="-fx-background-color: #27374D; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 2, 0);">
            <padding>
                <Insets bottom="30.0" left="25.0" right="25.0" top="30.0" />
