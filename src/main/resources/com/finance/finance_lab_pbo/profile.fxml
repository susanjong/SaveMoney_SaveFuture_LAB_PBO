                        <Button layoutX="124.0" layoutY="439.0" mnemonicParsing="false" prefHeight="46.0" prefWidth="545.0" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 20;" text="Delete Account">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
