<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.finance.finance_lab_pbo.DashboardController">
   <left>
      <VBox prefWidth="220.0" style="-fx-background-color: #27374D; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 2, 0);" spacing="15.0">
         <padding>
            <Insets bottom="30.0" left="25.0" right="25.0" top="30.0" />
         </padding>
         <children>
            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 25 12;" text="Personal Finance" />
            <Button fx:id="profileBtn" mnemonicParsing="false" prefWidth="170.0" prefHeight="45.0" 
                    style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1.5; -fx-border-radius: 25; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px; -fx-cursor: hand;" 
                    text="Profile">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="dashboardBtn" mnemonicParsing="false" onAction="#handleNavigation" prefWidth="170.0" prefHeight="45.0" 
                    style="-fx-background-color: #FFFFFF; -fx-border-radius: 25; -fx-text-fill: #365580; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);" 
                    text="Dashboard">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="incomeBtn" mnemonicParsing="false" onAction="#handleNavigation" prefWidth="170.0" prefHeight="45.0" 
                    style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1.5; -fx-border-radius: 25; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px; -fx-cursor: hand;" 
                    text="Income">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="spendingBtn" mnemonicParsing="false" onAction="#handleNavigation" prefWidth="170.0" prefHeight="45.0" 
                    style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1.5; -fx-border-radius: 25; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px; -fx-cursor: hand;" 
                    text="Spending">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </left>
   <center>
      <VBox style="-fx-background-color: linear-gradient(to bottom, #52C4D8 0%, #7DD3DF 25%, #A8E6ED 50%, #D4F4F8 75%, #FFFFFF 100%);">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0" style="-fx-padding: 20 0 10 0;">
               <children>
                  <Label style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);" text="Track your personal finance!">
                     <font>
                        <Font name="System Bold" size="32.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="40.0">
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="20.0" />
               </padding>
               <children>
                  <VBox alignment="CENTER" prefWidth="270.0" prefHeight="140.0" 
                        style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                     <children>
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #7F8C8D; -fx-font-weight: normal;" text="Balance">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="balanceLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50; -fx-padding: 8 0 0 0;" text="Rp 5.000.000">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefWidth="270.0" prefHeight="140.0" 
                        style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                     <children>
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #7F8C8D; -fx-font-weight: normal;" text="Income">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="incomeLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #27AE60; -fx-padding: 8 0 0 0;" text="Rp 15.000.000">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>
                        <Button fx:id="incomeDetailsBtn" mnemonicParsing="false" onAction="#showIncomeDetails" 
                                style="-fx-background-color: transparent; -fx-text-fill: #95A5A6; -fx-underline: true; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 0 0 0;" 
                                text="Show Details">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefWidth="270.0" prefHeight="140.0" 
                        style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                     <children>
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #7F8C8D; -fx-font-weight: normal;" text="Spend">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="spendLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #E74C3C; -fx-padding: 8 0 0 0;" text="Rp 10.000.000">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>
                        <Button fx:id="spendDetailsBtn" mnemonicParsing="false" onAction="#showSpendDetails" 
                                style="-fx-background-color: transparent; -fx-text-fill: #95A5A6; -fx-underline: true; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 0 0 0;" 
                                text="Show Details">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox style="-fx-padding: 40 50 40 50;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 0 0 20 0;">
                     <children>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Transaction History">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <padding>
                        <Insets bottom="20.0" />
                     </padding>
                     <children>
                        <ComboBox fx:id="sortComboBox" onAction="#onSortChange" promptText="Ascending" prefWidth="120.0" prefHeight="35.0"
                                  style="-fx-text-fill: #FFFFFF; -fx-background-radius: 18; -fx-border-radius: 18;" />
                        <ComboBox fx:id="periodComboBox" onAction="#onPeriodChange" promptText="1 week" prefWidth="120.0" prefHeight="35.0"
                                  style="-fx-text-fill: #FFFFFF; -fx-background-radius: 18; -fx-border-radius: 18;" />
                        <ComboBox fx:id="filterComboBox" onAction="#onFilterChange" promptText="Show All" prefWidth="120.0" prefHeight="35.0"
                                  style="-fx-text-fill: #FFFFFF; -fx-background-radius: 18; -fx-border-radius: 18;" />
                        <Region HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <TableView fx:id="transactionTable" prefHeight="250.0" 
                            style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3); -fx-table-cell-border-color: transparent;">
                     <columns>
                        <TableColumn fx:id="noColumn" prefWidth="60.0" text="No" 
                                    style="-fx-alignment: CENTER; -fx-text-fill: #2C3E50;" />
                        <TableColumn fx:id="activityColumn" prefWidth="200.0" text="Activity" 
                                    style="-fx-alignment: CENTER_LEFT; -fx-text-fill: #2C3E50;" />
                        <TableColumn fx:id="amountColumn" prefWidth="180.0" text="Income / Spending" 
                                    style="-fx-alignment: CENTER; -fx-text-fill: #2C3E50;" />
                        <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" 
                                    style="-fx-alignment: CENTER; -fx-text-fill: #2C3E50;" />
                        <TableColumn fx:id="balanceColumn" prefWidth="150.0" text="Balance" 
                                    style="-fx-alignment: CENTER; -fx-text-fill: #2C3E50;" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>