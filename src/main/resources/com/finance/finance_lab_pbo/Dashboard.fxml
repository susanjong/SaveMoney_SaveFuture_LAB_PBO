<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="DashboardController">
   <left>
      <VBox prefWidth="150.0" style="-fx-background-color: #2C3E50;" spacing="10.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Button fx:id="profileBtn" mnemonicParsing="false" prefWidth="110.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 20; -fx-text-fill: white;" text="Profile" />
            <Button fx:id="dashboardBtn" mnemonicParsing="false" onAction="#onDashboardClick" prefWidth="110.0" style="-fx-background-color: white; -fx-border-radius: 20; -fx-text-fill: #2C3E50;" text="Dashboard" />
            <Button fx:id="incomeBtn" mnemonicParsing="false" onAction="#onIncomeClick" prefWidth="110.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 20; -fx-text-fill: white;" text="Income" />
            <Button fx:id="spendingBtn" mnemonicParsing="false" onAction="#onSpendingClick" prefWidth="110.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 20; -fx-text-fill: white;" text="Spending" />
         </children>
      </VBox>
   </left>
   <center>
      <VBox style="-fx-background-color: linear-gradient(to bottom, #4ECDC4, #87CEEB);">
         <children>
            <HBox alignment="CENTER" prefHeight="80.0">
               <children>
                  <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Track your personal finance!" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="30.0">
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="10.0" />
               </padding>
               <children>
                  <VBox alignment="CENTER" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
                     <children>
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #666;" text="Balance" />
                        <Label fx:id="balanceLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: black;" text="Rp 5.000.000" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
                     <children>
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #666;" text="Income" />
                        <Label fx:id="incomeLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27AE60;" text="Rp 15.000.000" />
                        <Button fx:id="incomeDetailsBtn" mnemonicParsing="false" onAction="#showIncomeDetails" style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-underline: true;" text="Show Details" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
                     <children>
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #666;" text="Spend" />
                        <Label fx:id="spendLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #E74C3C;" text="Rp 10.000.000" />
                        <Button fx:id="spendDetailsBtn" mnemonicParsing="false" onAction="#showSpendDetails" style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-underline: true;" text="Show Details" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox style="-fx-padding: 30;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="20.0">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Transaction History" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="10.0">
                           <children>
                              <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="2 weeks, 3 weeks, 1 month" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                     <children>
                        <ComboBox fx:id="sortComboBox" onAction="#onSortChange" promptText="Descending" style="-fx-background-color: #34495E; -fx-text-fill: white;" value="Ascending" />
                        <ComboBox fx:id="periodComboBox" onAction="#onPeriodChange" promptText="1 week" style="-fx-background-color: #34495E; -fx-text-fill: white;" />
                        <ComboBox fx:id="filterComboBox" onAction="#onFilterChange" promptText="Show All" style="-fx-background-color: #34495E; -fx-text-fill: white;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-text-fill: white;" text="Income, Spending" />
                     </children>
                  </HBox>
                  <TableView fx:id="transactionTable" prefHeight="200.0" style="-fx-background-color: white; -fx-background-radius: 10;">
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                     <columns>
                        <TableColumn fx:id="noColumn" prefWidth="50.0" text="No" />
                        <TableColumn fx:id="activityColumn" prefWidth="150.0" text="Activity" />
                        <TableColumn fx:id="amountColumn" prefWidth="150.0" text="Income / Spending" />
                        <TableColumn fx:id="dateColumn" prefWidth="100.0" text="Date" />
                        <TableColumn fx:id="balanceColumn" prefWidth="120.0" text="Balance" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>