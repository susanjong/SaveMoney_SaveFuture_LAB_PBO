<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.finance.finance_lab_pbo.SpendController">
   <left>
      <VBox prefWidth="220.0" style="-fx-background-color: #27374D; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 2, 0);" spacing="15.0">
         <padding>
            <Insets bottom="30.0" left="25.0" right="25.0" top="30.0" />
         </padding>
         <children>
            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 25 12;" text="Personal Finance" />
            <Button fx:id="profileBtn" mnemonicParsing="false" onAction="#handleNavigation" prefWidth="170.0" prefHeight="45.0" 
                    style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1.5; -fx-border-radius: 25; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px; -fx-cursor: hand;" 
                    text="Profile">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="dashboardBtn" mnemonicParsing="false" onAction="#handleNavigation" prefWidth="170.0" prefHeight="45.0" 
                    style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1.5; -fx-border-radius: 25; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px; -fx-cursor: hand;" 
                    text="Dashboard">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="incomeBtn" mnemonicParsing="false" onAction="#handleNavigation" prefWidth="170.0" prefHeight="45.0" 
                    style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1.5; -fx-border-radius: 25; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px; -fx-cursor: hand;" 
                    text="Income">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="spendingBtn" mnemonicParsing="false" onAction="#handleNavigation" prefWidth="170.0" prefHeight="45.0" 
                    style="-fx-background-color: #FFFFFF; -fx-border-radius: 25; -fx-text-fill: #365580; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);" 
                    text="Spending">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </left>
   <center>
      <VBox style="-fx-background-color: linear-gradient(to bottom, #52C4D8 0%, #7DD3DF 25%, #A8E6ED 50%, #D4F4F8 75%, #FFFFFF 100%);">
         <children>
            <HBox alignment="CENTER" style="-fx-background-color: #1F6E8C;">
               <Label text="Track your spending!" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;">
                  <HBox.margin>
                     <Insets top="8.0" bottom="8.0" />
                  </HBox.margin>
               </Label>
            </HBox>
            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox prefWidth="600.0" HBox.hgrow="ALWAYS">
                     <children>
                        <!-- Filter Section -->
                        <HBox spacing="15.0" style="-fx-padding: 10 0 10 0;" alignment="CENTER_LEFT">
                           <children>
                              <Label text="Filter by:" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                              <Button fx:id="filterAllBtn" mnemonicParsing="false" onAction="#filterAll" 
                                      style="-fx-background-color: #1F6E8C; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-size: 11px; -fx-padding: 5 15;" 
                                      text="All" />
                              <Button fx:id="filter1WeekBtn" mnemonicParsing="false" onAction="#filter1Week" 
                                      style="-fx-background-color: transparent; -fx-border-color: #1F6E8C; -fx-border-width: 1; -fx-border-radius: 15; -fx-text-fill: #1F6E8C; -fx-background-radius: 15; -fx-font-size: 11px; -fx-padding: 5 15;" 
                                      text="1 Week" />
                              <Button fx:id="filter1MonthBtn" mnemonicParsing="false" onAction="#filter1Month" 
                                      style="-fx-background-color: transparent; -fx-border-color: #1F6E8C; -fx-border-width: 1; -fx-border-radius: 15; -fx-text-fill: #1F6E8C; -fx-background-radius: 15; -fx-font-size: 11px; -fx-padding: 5 15;" 
                                      text="1 Month" />
                              <Button fx:id="filter1YearBtn" mnemonicParsing="false" onAction="#filter1Year" 
                                      style="-fx-background-color: transparent; -fx-border-color: #1F6E8C; -fx-border-width: 1; -fx-border-radius: 15; -fx-text-fill: #1F6E8C; -fx-background-radius: 15; -fx-font-size: 11px; -fx-padding: 5 15;" 
                                      text="1 Year" />
                              <ComboBox fx:id="monthFilterComboBox" prefWidth="120.0" 
                                       style="-fx-background-radius: 10; -fx-font-size: 11px;" 
                                       promptText="Select Month" />
                              <TextField fx:id="yearFilterField" prefWidth="80.0" 
                                       style="-fx-background-radius: 10; -fx-font-size: 11px;" 
                                       promptText="Year" />
                           </children>
                        </HBox>
                        
                        <TableView fx:id="spendingTable" prefHeight="320.0">
                           <columns>
                              <TableColumn fx:id="noColumn" prefWidth="40.0" text="No" />
                              <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Category" />
                              <TableColumn fx:id="descriptionColumn" prefWidth="200.0" text="Description" />
                              <TableColumn fx:id="amountColumn" prefWidth="120.0" text="Amount (IDR)" />
                              <TableColumn fx:id="dateColumn" prefWidth="100.0" text="Date" />
                           </columns>
                        </TableView>
                        <HBox spacing="20.0" style="-fx-padding: 20;">
                           <children>
                              <VBox>
                                 <children>
                                    <Label text="Total Spending :" textFill="BLACK">
                                       <font>
                                          <Font name="System Bold" size="14.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </VBox>
                              <VBox>
                                 <children>
                                    <Label fx:id="totalSpendingLabel" style="-fx-background-color: #FFFFFF; -fx-padding: 5 10; -fx-background-radius: 5;" text="Rp 0">
                                       <font>
                                          <Font name="System Bold" size="14.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </VBox>
                              <VBox>
                                 <children>
                                    <Label text="Most Spending :" textFill="BLACK">
                                       <font>
                                          <Font name="System Bold" size="14.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </VBox>
                              <VBox>
                                 <children>
                                    <Label fx:id="mostSpendingLabel" style="-fx-background-color: #FFFFFF; -fx-padding: 5 10; -fx-background-radius: 5;" text="Rp 0">
                                       <font>
                                          <Font name="System Bold" size="14.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 20;">
                           <children>
                              <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#deleteSpending" style="-fx-background-color: #E55050; -fx-text-fill: white; -fx-background-radius: 5;" text="Delete Spending" />
                              <Button fx:id="updateBtn" mnemonicParsing="false" onAction="#updateSpending" style="-fx-background-color: #16610E; -fx-text-fill: white; -fx-background-radius: 5;" text="Update Spending" />
                           </children>
                        </HBox>
                     </children>
                     <HBox.margin>
                        <Insets bottom="20.0" left="20.0" right="10.0" top="20.0" />
                     </HBox.margin>
                  </VBox>
                  <VBox prefWidth="300.0" style="-fx-background-color: #B2DEE5;" spacing="10.0" alignment="TOP_CENTER">
                     <children>
                        <Label text="Category" textFill="BLACK">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </Label>
                        <ComboBox fx:id="categoryComboBox" prefWidth="250.0" style="-fx-background-radius: 5;">
                           <VBox.margin>
                              <Insets bottom="15.0" />
                           </VBox.margin>
                        </ComboBox>
                        <Label text="Description" textFill="BLACK">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="descriptionField" style="-fx-background-radius: 5;">
                           <VBox.margin>
                              <Insets bottom="15.0" />
                           </VBox.margin>
                        </TextField>
                        <Label text="Amount" textFill="BLACK">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="amountField" style="-fx-background-radius: 5;">
                           <VBox.margin>
                              <Insets bottom="15.0" />
                           </VBox.margin>
                        </TextField>
                        <Label text="Date" textFill="BLACK">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </Label>
                        <DatePicker fx:id="datePicker" style="-fx-background-radius: 5;">
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </DatePicker>
                        <Button fx:id="addBtn" mnemonicParsing="false" onAction="#addSpending" prefWidth="200.0" style="-fx-background-color: #16610E; -fx-text-fill: white; -fx-background-radius: 5;" text="Add Spending">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                     </children>
                     <HBox.margin>
                        <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
                     </HBox.margin>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>